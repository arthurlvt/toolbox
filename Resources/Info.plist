<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Toolbox</string>
    <key>CFBundleDisplayName</key>
    <string>Toolbox</string>
    <key>CFBundleIdentifier</key>
    <string>fr.arthur.toolbox</string>
    <key>CFBundleExecutable</key>
    <string>Toolbox</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>2.0</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>fr</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- Page d'accueil : pense-bête dans l'app Notes -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Toolbox crée tes pense-bêtes dans Notes et affiche ta note épinglée sur sa page d'accueil.</string>

    <!-- Page d'accueil : événements du jour -->
    <key>NSRemindersUsageDescription</key>
    <string>Toolbox crée un rappel « Recharge ton Mac » qui sonne sur ton iPhone quand la batterie est basse.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>Toolbox crée un rappel « Recharge ton Mac » qui sonne sur ton iPhone quand la batterie est basse.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>Toolbox affiche les événements du jour sur sa page d'accueil.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Toolbox affiche les événements du jour sur sa page d'accueil.</string>

    <!-- Autorise le HTTP non chiffré vers le Mac lui-même (Ollama sur 127.0.0.1:11434) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>127.0.0.1</key>
            <dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
            <key>localhost</key>
            <dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
        </dict>
    </dict>

    <!-- « Ouvrir avec → Toolbox » et glisser sur l'icône du Dock -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Document PDF</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array><string>com.adobe.pdf</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Source LaTeX</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeExtensions</key>
            <array><string>tex</string></array>
            <key>LSItemContentTypes</key>
            <array><string>org.tug.tex</string><string>public.tex</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Image</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array><string>public.image</string></array>
        </dict>
    </array>

    <!-- Clic droit dans le Finder → Services -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict><key>default</key><string>Toolbox : Compresser</string></dict>
            <key>NSMessage</key>
            <string>compressPDF</string>
            <key>NSPortName</key>
            <string>Toolbox</string>
            <key>NSRequiredContext</key>
            <dict/>
            <key>NSSendFileTypes</key>
            <array><string>com.adobe.pdf</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict><key>default</key><string>Toolbox : Fusionner</string></dict>
            <key>NSMessage</key>
            <string>mergePDF</string>
            <key>NSPortName</key>
            <string>Toolbox</string>
            <key>NSRequiredContext</key>
            <dict/>
            <key>NSSendFileTypes</key>
            <array><string>com.adobe.pdf</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict><key>default</key><string>Toolbox : Rendre cherchable (OCR)</string></dict>
            <key>NSMessage</key>
            <string>ocrPDF</string>
            <key>NSPortName</key>
            <string>Toolbox</string>
            <key>NSRequiredContext</key>
            <dict/>
            <key>NSSendFileTypes</key>
            <array><string>com.adobe.pdf</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict><key>default</key><string>Toolbox : Ouvrir</string></dict>
            <key>NSMessage</key>
            <string>openInToolbox</string>
            <key>NSPortName</key>
            <string>Toolbox</string>
            <key>NSRequiredContext</key>
            <dict/>
            <key>NSSendFileTypes</key>
            <array><string>com.adobe.pdf</string><string>public.image</string><string>public.plain-text</string></array>
        </dict>
    </array>
</dict>
</plist>
